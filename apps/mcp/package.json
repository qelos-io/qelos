{
  "name": "@qelos/mcp",
  "version": "3.11.0",
  "license": "MIT",
  "author": "David Meir-Levy <davidmeirlevy@gmail.com>",
  "description": "Remote MCP HTTP service for Qelos",
  "keywords": [
    "qelos",
    "mcp"
  ],
  "engines": {
    "npm": ">=5",
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch ./index.ts",
    "start": "node --import tsx --use_strict index.ts",
    "test": "node --import tsx --experimental-test-module-mocks --test --test-force-exit \"server/**/*.test.ts\""
  },
  "main": "index.ts",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@qelos/api-kit": "workspace:^",
    "@qelos/cache-manager": "workspace:^",
    "@qelos/global-types": "workspace:^",
    "@qelos/sdk": "workspace:^",
    "tsx": "^4.20.4",
    "zod": "^3.25.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/express": "^4.17.8",
    "@types/node": "^22.5.4",
    "typescript": "^4.9.5"
  }
}
