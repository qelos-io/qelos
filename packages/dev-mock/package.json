{
  "name": "@qelos/dev-mock",
  "version": "4.4.0",
  "description": "Mock Qelos API server for local development without a connected Qelos tenant",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "author": "David Meir-Levy <davidmeirlevy@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "tsx": "^4.20.4",
    "typescript": "^5.4.5"
  }
}
