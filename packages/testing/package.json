{
  "name": "@qelos/testing",
  "version": "4.4.0",
  "description": "Testing suite for apps using the Qelos SDK or integrators: a local in-memory Qelos API for development, integration tests and CI",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "sdk": [
        "./dist/sdk/index.d.ts"
      ],
      "fixtures": [
        "./dist/fixtures/index.d.ts"
      ],
      "http": [
        "./dist/http/index.d.ts"
      ],
      "cassette": [
        "./dist/cassette/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./sdk": {
      "import": {
        "types": "./dist/sdk/index.d.ts",
        "default": "./dist/sdk/index.js"
      },
      "require": {
        "types": "./dist/cjs/sdk/index.d.ts",
        "default": "./dist/cjs/sdk/index.js"
      },
      "default": "./dist/sdk/index.js"
    },
    "./fixtures": {
      "import": {
        "types": "./dist/fixtures/index.d.ts",
        "default": "./dist/fixtures/index.js"
      },
      "require": {
        "types": "./dist/cjs/fixtures/index.d.ts",
        "default": "./dist/cjs/fixtures/index.js"
      },
      "default": "./dist/fixtures/index.js"
    },
    "./http": {
      "import": {
        "types": "./dist/http/index.d.ts",
        "default": "./dist/http/index.js"
      },
      "require": {
        "types": "./dist/cjs/http/index.d.ts",
        "default": "./dist/cjs/http/index.js"
      },
      "default": "./dist/http/index.js"
    },
    "./cassette": {
      "import": {
        "types": "./dist/cassette/index.d.ts",
        "default": "./dist/cassette/index.js"
      },
      "require": {
        "types": "./dist/cjs/cassette/index.d.ts",
        "default": "./dist/cjs/cassette/index.js"
      },
      "default": "./dist/cassette/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "author": "David Meir-Levy <davidmeirlevy@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@qelos/sdk": "workspace:^",
    "@types/node": "^22.5.4",
    "node-jq": "^6.0.1",
    "tsx": "^4.20.4",
    "typescript": "^5.4.5"
  },
  "bin": {
    "qelos-testing": "./dist/cli/bin.js"
  },
  "peerDependencies": {
    "@qelos/sdk": "workspace:^",
    "node-jq": ">=4"
  },
  "peerDependenciesMeta": {
    "@qelos/sdk": {
      "optional": true
    },
    "node-jq": {
      "optional": true
    }
  }
}
