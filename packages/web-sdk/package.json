{
  "name": "@qelos/web-sdk",
  "version": "4.5.1",
  "description": "Frontend Web SDK for Qelos API",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/index.js"
    },
    "./dist/*.js": {
      "import": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "require": {
        "types": "./dist/cjs/*.d.ts",
        "default": "./dist/cjs/*.js"
      },
      "default": "./dist/*.js"
    },
    "./dist/*": {
      "import": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "require": {
        "types": "./dist/cjs/*.d.ts",
        "default": "./dist/cjs/*.js"
      },
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "author": "David Meir-Levy <davidmeirlevy@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "happy-dom": "^21.0.1",
    "tsx": "^4.21.0",
    "typescript": "^4.9.5"
  },
  "gitHead": "13468bc51557291935b96b1aeaa837b8b52861e8"
}
